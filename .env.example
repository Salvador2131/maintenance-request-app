# ─── Supabase ───────────────────────────────────────────────────────────────
# Dashboard: https://supabase.com/dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# En el dashboard de Supabase aparece como "anon" o "publishable" — es la misma clave.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-anon-key
# Alias aceptado por compatibilidad:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo servidor (NUNCA exponer al cliente ni commitear)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ─── Vercel (automático al conectar el repo) ────────────────────────────────
# Configura las mismas variables en: Vercel → Project → Settings → Environment Variables
